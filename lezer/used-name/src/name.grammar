@top ClassAttributeValue {
  '"' UsedClassName* '"' |
  "'" UsedClassName* "'" |
  UsedClassName
}

@top IdAttributeValue {
  '"' UsedIdName? '"' |
  "'" UsedIdName? "'" |
  UsedIdName
}

@tokens {
  UsedClassName { name }
  UsedIdName { name }
  name { !["' \t\n\r]+ }
  space { $[ \t\n\r]+ }
}

@skip { space }
