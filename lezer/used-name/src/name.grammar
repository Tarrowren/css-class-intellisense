@top ClassAttributeValue {
  '"' UsedClassName* '"' |
  "'" UsedClassName* "'" |
  UsedClassName
}

@top IdAttributeValue {
  '"' UsedIdName? '"' |
  "'" UsedIdName? "'" |
  UsedIdName
}

@tokens {
  UsedClassName { !["'\r\n\t\f\v ]+ }
  UsedIdName { !["'\r\n\t\f\v ]+ }
  space { $[\r\n\t\f\v ]+ }
}

@skip { space }
