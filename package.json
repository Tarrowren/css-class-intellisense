{
  "name": "css-class-intellisense",
  "displayName": "CSS Class Intellisense",
  "version": "4.6.4",
  "type": "commonjs",
  "description": "%cssci.description%",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:php",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:less"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "%cssci.description%",
        "properties": {
          "cssci.useNodeFS": {
            "type": "boolean",
            "default": true,
            "description": "%cssci.useNodeFS.description%"
          },
          "cssci.languages.vue": {
            "type": "boolean",
            "default": true,
            "description": "%cssci.languages.vue.description%"
          },
          "cssci.globalCSSFiles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%cssci.globalCSSFiles.description%"
          },
          "cssci.include": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%cssci.include.description%"
          },
          "cssci.exclude": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%cssci.exclude.description%"
          }
        }
      }
    ]
  },
  "main": "dist/node/client.cjs",
  "browser": "dist/browser/client.umd.js",
  "l10n": "l10n",
  "scripts": {
    "watch:check": "tsc -b -w",
    "watch": "tsdown -w --env.PLATFORM=node",
    "check": "tsc -b",
    "lint": "eslint --config eslint.config.mts",
    "test": "vitest --run",
    "build": "tsdown --env.NODE_ENV=production",
    "open-in-browser": "vscode-test-web --extensionDevelopmentPath=. ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarrowren/css-class-intellisense.git"
  },
  "keywords": [
    "html",
    "vue",
    "react",
    "php",
    "css",
    "scss",
    "sass",
    "less",
    "class",
    "className",
    "intellisense"
  ],
  "author": "Tarrowren",
  "publisher": "tarrow",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tarrowren/css-class-intellisense/issues"
  },
  "homepage": "https://github.com/Tarrowren/css-class-intellisense#readme",
  "workspaces": [
    "shared",
    "client/common",
    "client/node",
    "client/browser",
    "server/common",
    "server/node",
    "server/browser",
    "lezer/used-name",
    "lezer/less"
  ],
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@ryoppippi/unplugin-typia": "^2.6.5",
    "@types/node": "^22.19.3",
    "@vscode/test-web": "^0.0.78",
    "eslint": "^9.39.2",
    "jiti": "^2.6.1",
    "tsdown": "^0.20.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.18"
  }
}
